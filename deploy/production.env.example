# Copy to deploy/.env.production; do not commit actual credentials.
FORMULA_APP_IMAGE=formula-ai:production
RECOGNITION_MODEL_PATH=./models/formula
POSTGRES_USER=formula
POSTGRES_DB=formula_ai
POSTGRES_PASSWORD=
NUXT_AUTH_SECRET=
NUXT_AUTH_BASE_URL=https://www.ideal-formula.top
NUXT_STORAGE_BUCKET=formula-private
NUXT_STORAGE_ACCESS_KEY_ID=
NUXT_STORAGE_SECRET_ACCESS_KEY=
NUXT_RECOGNITION_API_KEY=
NUXT_AI_API_KEY=
NUXT_AI_MODEL=deepseek-flash
FORMULA_SMTP_USER=
FORMULA_SMTP_PASSWORD=
RECOGNITION_CPU_THREADS=2
RECOGNITION_MEMORY=1792m
# Default is read-only reporting. Do not enable production deletion implicitly.
FORMULA_RESOURCE_ORPHAN_MODE=report
