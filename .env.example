# 配置模板：纯前端演示可独立运行，账号、上传和后台任务需要数据库。
# npm run db:env仅在.env不存在时创建文件，并生成随机数据库密码和匹配的连接地址。
# 应用、Prisma和Worker连接数据库的完整地址：协议://用户名:密码@主机:端口/数据库名。
NUXT_DATABASE_URL=postgresql://formula:formula_local_dev@127.0.0.1:5432/formula_ai
# 图片识别来源：mock为固定模拟，python调用Docker识别服务；真实模式失败不回退模拟。
NUXT_RECOGNITION_PROVIDER=mock
# Python识别服务基础地址；Nuxt/Worker在本机运行时使用映射端口8001。
NUXT_RECOGNITION_SERVICE_URL=
# Worker与Python共用的服务鉴权密钥，由npm run recognition:env生成，与DeepSeek密钥独立。
NUXT_RECOGNITION_API_KEY=
# 模型导出目录，相对于compose.yaml；本项目与桌面model文件夹相邻。
RECOGNITION_MODEL_PATH=../model
# Python服务映射到本机的端口；容器内部使用8000。
RECOGNITION_PORT=8001
# CPU推理线程数，首轮使用4；改变后重新创建识别容器。
RECOGNITION_CPU_THREADS=4
# DeepSeek API密钥，供服务端调用；在本地填写，不发送到浏览器。
NUXT_AI_API_KEY=
# 明确选择mock或deepseek；真实模式缺少密钥时会提示失败，不会自动换成模拟回答。
# 账号回答来源：deepseek为真实模型，mock为固定模拟。
NUXT_AI_PROVIDER=mock
# 调用的DeepSeek模型名称，例如deepseek-flash。
NUXT_AI_MODEL=deepseek-flash
# DeepSeek API基础地址；官方地址为https://api.deepseek.com。
NUXT_AI_BASE_URL=https://api.deepseek.com
# 每位用户每日可提交的识别任务数，默认50。
NUXT_RECOGNITION_DAILY_LIMIT=50
# 每位用户每日可提交的对话轮数，默认30。
NUXT_CHAT_DAILY_LIMIT=30
# 每位用户每日可提交的Word导出任务数，默认20。
NUXT_EXPORT_DAILY_LIMIT=20
# Pandoc路径可留空，使用项目内便携版或系统PATH中的可执行文件。
# Word转换器Pandoc的可执行文件路径；留空时使用项目便携版或系统PATH。
PANDOC_PATH=

# npm run auth:env会补充缺少的随机会话密钥；更改账号配置后重启Nuxt。
# 账号会话签名密钥，不是用户登录密码；更改会影响已有会话校验。
NUXT_AUTH_SECRET=
# 账号服务所在的网站根地址；本机为http://127.0.0.1:3000。
NUXT_AUTH_BASE_URL=http://127.0.0.1:3000

# npm run storage:env会补齐空的私有存储配置并生成随机访问凭据。
# S3兼容私有对象存储的API地址；本机连接SeaweedFS的8333端口。
NUXT_STORAGE_ENDPOINT=http://127.0.0.1:8333
# S3请求使用的区域签名标识；本机兼容服务约定使用us-east-1。
NUXT_STORAGE_REGION=us-east-1
# 保存图片和Word文件的存储桶名称，类似一个逻辑文件容器。
NUXT_STORAGE_BUCKET=formula-private
# 对象存储访问凭据的标识，用于识别调用身份。
NUXT_STORAGE_ACCESS_KEY_ID=
# 对象存储的秘密访问密钥，与访问标识配对，用于签名请求。
NUXT_STORAGE_SECRET_ACCESS_KEY=

# 以下为本机Docker数据库配置；正式部署时使用对应环境的连接和凭据。
# Docker PostgreSQL首次初始化时创建的数据库用户名。
POSTGRES_USER=formula
# Docker PostgreSQL初始化密码，需与NUXT_DATABASE_URL中的密码匹配。
POSTGRES_PASSWORD=formula_local_dev
# Docker PostgreSQL初始化数据库名，需与连接地址末尾的库名匹配。
POSTGRES_DB=formula_ai
# 数据库映射到本机的端口；容器内仍使用5432，应用连接地址使用本机端口。
POSTGRES_PORT=5432

# R12 资源治理：服务端专用，所有 API/Worker 实例必须采用相同配置；均为正整数。
# 容量是已登记文件与活动预留的逻辑字节，不是整个桶/磁盘的物理用量。
FORMULA_RESOURCE_OWNER_BYTES=134217728
FORMULA_RESOURCE_GLOBAL_BYTES=8589934592
# 图片正文读取/解码/上传的账号、全局并发槽位；不等于 Worker 执行并发。
FORMULA_RESOURCE_OWNER_UPLOADS=1
FORMULA_RESOURCE_GLOBAL_UPLOADS=2
FORMULA_RESOURCE_UPLOADS_PER_MINUTE=10
# QUEUED+PROCESSING 的识别准入数量，拒绝不扣每日额度。
FORMULA_RESOURCE_OWNER_RECOGNITIONS=2
FORMULA_RESOURCE_GLOBAL_RECOGNITIONS=16
# 租约到期进入核对，禁止仅按 TTL 释放；正文超时实际停止读取。
FORMULA_RESOURCE_LEASE_SECONDS=3600
FORMULA_RESOURCE_BODY_SECONDS=30
# 不提供自动生产清理开关；resources:audit:test 默认只读且限定 R1 身份。
# 已确认无引用对象的批量回收宽限（秒），不是有效文件的下载有效期。
FORMULA_RESOURCE_FILE_GRACE_SECONDS=86400
FORMULA_RESOURCE_AVATAR_GRACE_SECONDS=604800
