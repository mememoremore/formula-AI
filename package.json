{
  "name": "formula-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs dev --host 127.0.0.1",
    "build": "prisma generate && node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs build",
    "preview": "node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs preview --host 127.0.0.1",
    "start": "node scripts/run-node.mjs .output/server/index.mjs",
    "prepare": "prisma generate && node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs prepare",
    "typecheck": "node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs typecheck && tsc --project tsconfig.database.json",
    "test:api": "node --test tests/api.test.mjs",
    "test:db": "tsx --test tests/database.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:workspace": "tsx --test tests/workspace.test.ts",
    "test:library": "tsx --test tests/library.test.ts",
    "test:ui": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs --test tests/navigation.test.ts tests/profile.test.ts",
    "test:profile": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs --test tests/profile-api.test.ts",
    "worker:setup": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/queue-setup.ts",
    "worker": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/worker.ts",
    "test:documents": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs --test tests/documents.test.ts",
    "test:jobs": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs --test tests/jobs.test.ts",
    "test:inference": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs --test tests/inference.test.ts",
    "test:recognition": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs --test tests/recognition.test.ts",
    "recognition:env": "node scripts/setup-recognition-env.mjs",
    "recognition:up": "npm run recognition:env && docker compose up -d --build --wait --wait-timeout 300 recognition",
    "recognition:down": "docker compose stop recognition",
    "recognition:check": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/check-recognition.ts",
    "recognition:verify": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/verify-recognition-flow.ts",
    "test:recognition-service": "docker compose run --rm --no-deps recognition python -m unittest discover -s tests -v",
    "test:private-config": "node --test tests/private-config.test.mjs",
    "format": "prettier --write app shared server scripts tests docs prisma/*.ts *.json *.ts *.yaml *.md",
    "format:check": "prettier --check app shared server scripts tests docs prisma/*.ts *.json *.ts *.yaml *.md",
    "db:env": "node scripts/setup-db-env.mjs",
    "auth:env": "node scripts/setup-auth-env.mjs",
    "storage:env": "node scripts/setup-storage-env.mjs",
    "storage:up": "npm run storage:env && docker compose up -d --wait --wait-timeout 120 storage",
    "storage:down": "docker compose stop storage",
    "storage:check": "tsx scripts/check-storage.ts",
    "db:up": "docker compose up -d --wait --wait-timeout 60 postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:check": "tsx scripts/check-database.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@better-auth/prisma-adapter": "1.7.12",
    "@langchain/core": "1.2.20",
    "@langchain/deepseek": "1.1.18",
    "@lucide/vue": "1.60.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "dotenv": "^17.2.3",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "nuxt": "4.6.2",
    "pg": "^8.16.3",
    "pg-boss": "12.38.0",
    "sharp": "0.35.5",
    "vue": "^3.5.22",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.0"
  }
}
