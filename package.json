{
  "name": "formula-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs dev --host 127.0.0.1",
    "build": "prisma generate && node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs build",
    "preview": "node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs preview --host 127.0.0.1",
    "start": "node scripts/run-node.mjs .output/server/index.mjs",
    "prepare": "prisma generate && node scripts/run-node.mjs node_modules/nuxt/bin/nuxt.mjs prepare",
    "typecheck": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/check-types.ts",
    "test:api": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts api",
    "test:db": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts db",
    "test:auth": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts auth",
    "test:workspace": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts workspace",
    "test:library": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts library",
    "test:ui": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts unit",
    "test:profile": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts profile",
    "worker:setup": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/queue-setup.ts",
    "worker": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/worker.ts",
    "test:documents": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts documents",
    "test:db:migrate": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-migrate.ts",
    "resources:audit:test": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/resource-audit.ts",
    "test:resources": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts resources",
    "test:lease-recovery": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts lease-recovery",
    "test:recovery": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts recovery",
    "test:jobs": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts jobs",
    "test:inference": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts protocols",
    "test:recognition": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts protocols",
    "recognition:env": "node scripts/setup-recognition-env.mjs",
    "recognition:up": "npm run recognition:env && docker compose up -d --build --wait --wait-timeout 300 recognition",
    "recognition:down": "docker compose stop recognition",
    "recognition:check": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/check-recognition.ts",
    "recognition:verify": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/verify-recognition-flow.ts",
    "test:recognition-service": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-python.ts",
    "test:private-config": "npm run check:build",
    "format": "prettier --write app shared server scripts tests docs prisma/*.ts *.json *.ts *.yaml *.md",
    "format:check": "prettier --check app shared server scripts tests docs prisma/*.ts *.json *.ts *.yaml *.md",
    "db:env": "node scripts/setup-db-env.mjs",
    "auth:env": "node scripts/setup-auth-env.mjs",
    "storage:env": "node scripts/setup-storage-env.mjs",
    "storage:up": "npm run storage:env && docker compose up -d --wait --wait-timeout 120 storage",
    "storage:down": "docker compose stop storage",
    "storage:check": "tsx scripts/check-storage.ts",
    "db:up": "docker compose up -d --wait --wait-timeout 60 postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:check": "tsx scripts/check-database.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck:tests": "node scripts/run-node.mjs node_modules/typescript/bin/tsc --project tsconfig.database.json",
    "test": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts unit",
    "test:unit": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts unit",
    "test:protocols": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts protocols",
    "test:integration": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-suite.ts integration",
    "test:env:create": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-environment.ts create",
    "test:env:check": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-environment.ts check",
    "test:env:stop": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-environment.ts stop",
    "test:server": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-environment.ts api",
    "test:worker": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-environment.ts worker",
    "check:assets": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/check-assets.ts",
    "check:build": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-build.ts",
    "preview:design": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/design-preview.ts",
    "typecheck:design": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/design-preview.ts typecheck",
    "check:source-format": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/check-source-format.ts",
    "quality": "npm run quality:quick",
    "quality:quick": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/check-quality.ts",
    "test:isolated": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-isolated.ts integration",
    "test:e2e": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-browser-matrix.ts",
    "test:e2e:faults": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-isolated.ts faults",
    "test:isolated:cleanup": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-cleanup.ts",
    "test:isolated:cleanup-proof": "node scripts/run-node.mjs node_modules/tsx/dist/cli.mjs scripts/test-isolated.ts cleanup-proof"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@better-auth/prisma-adapter": "1.7.12",
    "@langchain/core": "1.2.20",
    "@langchain/deepseek": "1.1.18",
    "@lucide/vue": "1.60.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "cropperjs": "2.3.1",
    "dotenv": "^17.2.3",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "nuxt": "4.6.2",
    "pg": "^8.16.3",
    "pg-boss": "12.38.0",
    "sharp": "0.35.5",
    "vue": "^3.5.22",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.0"
  },
  "imports": {
    "#shared/formula-validation": "./shared/formula-validation.ts",
    "#shared/explanation": "./shared/explanation.ts"
  }
}
