        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(formula_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(formula_http_requests_total[5m]))) and on() (sum(rate(formula_http_requests_total[5m]))>0)",
          "legendFormat": "{{service}} {{kind}} {{mode}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "暂无样本"
